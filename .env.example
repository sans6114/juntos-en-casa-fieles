# PostgreSQL (debe coincidir con docker-compose.yml)
DATABASE_URL="postgresql://juntos:juntos@localhost:5433/juntos?schema=public"

# URL pública del sitio (SEO / Open Graph). En prod: https://tudominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Credenciales del admin único (se usan en el seed para crear el User ADMIN)
ADMIN_EMAIL="admin26@juntosencasa.com"
ADMIN_PASSWORD="JuntosEnCasa.123"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Resend — envío de emails de recuperación de contraseña
# Obtené la API key en https://resend.com/api-keys
RESEND_API_KEY=""
# Remitente verificado en Resend (en dev podés usar "Juntos en Casa <onboarding@resend.dev>")
EMAIL_FROM="Juntos en Casa <no-reply@tudominio.com>"

# Google OAuth — credenciales de Google Cloud (OAuth 2.0 Client ID)
# Redirect URI autorizada: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
