# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — copiá este archivo a .env
#
# Los valores asignados abajo son los de DESARROLLO LOCAL: copiar
# a .env funciona tal cual (solo hay que completar los secretos "").
#
# Los tres ambientes del proyecto:
#   local     → Docker (docker-compose.yml) + next dev
#   staging   → Vercel Preview (rama develop) + Neon branch "staging"
#   producción→ Vercel Production + Neon rama principal
#
# En staging y producción las variables se cargan en el dashboard de
# Vercel (Settings → Environment Variables), NO en este archivo.
# Nunca commitees credenciales reales acá.
# ─────────────────────────────────────────────────────────────

# PostgreSQL — runtime de la app (debe coincidir con docker-compose.yml, puerto 5433)
#   local:      el valor de abajo
#   staging:    connection string POOLED de la Neon branch "staging" (la que tiene "-pooler")
#   producción: connection string POOLED de la Neon rama principal
# El pooled es obligatorio: src/lib/prisma.ts usa @prisma/adapter-pg sobre funciones
# serverless de Vercel y sin pooler se agotan las conexiones.
DATABASE_URL="postgresql://juntos:juntos@localhost:5433/juntos?schema=public"

# PostgreSQL — solo para las migraciones del build en Vercel (script "vercel-build").
# Debe ser la connection string DIRECTA de Neon (SIN "-pooler"): el pooler no sirve
# para migraciones.
#   local:      no aplica (en local se corre prisma migrate dev contra Docker)
#   staging:    string DIRECTA de la Neon branch "staging"
#   producción: string DIRECTA de la Neon rama principal
# Se carga únicamente en el dashboard de Vercel, en los scopes Production y Preview.
DIRECT_DATABASE_URL=""

# URL pública del sitio (SEO / Open Graph)
#   local:      http://localhost:3000
#   staging:    alias estable de la rama develop en Vercel
#               (https://<proyecto>-git-develop-<equipo>.vercel.app)
#   producción: la URL *.vercel.app hasta el 19/8; el dominio propio desde el 20/8
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Credenciales del admin único (solo las usa prisma/seed.ts para crear el User ADMIN)
# ATENCIÓN: en producción el seed se corre UNA sola vez y con credenciales fuertes.
# JAMÁS uses los valores de ejemplo de este archivo en staging ni en producción.
ADMIN_EMAIL="admin26@juntosencasa.com"
ADMIN_PASSWORD="JuntosEnCasa.123"

# Auth.js — genera uno con: openssl rand -base64 32
# Usá uno DISTINTO por ambiente (local, staging y producción). Nunca reutilices el mismo.
AUTH_SECRET=""

# Resend — envío de emails de recuperación de contraseña
# Obtené la API key en https://resend.com/api-keys (una por ambiente)
RESEND_API_KEY=""
# Remitente local: onboarding@resend.dev. En local solo entrega al buzón
# dueño de la API key. No inventar un from de producción.
EMAIL_FROM="Juntos en Casa <onboarding@resend.dev>"

# Google OAuth — credenciales de Google Cloud (OAuth 2.0 Client ID)
# Se usa el MISMO OAuth Client en los tres ambientes, pero hay que registrar
# una redirect URI por cada uno (<NEXT_PUBLIC_SITE_URL>/api/auth/callback/google):
#   local:      http://localhost:3000/api/auth/callback/google
#   staging:    la del alias estable de develop
#   producción: la de la URL de producción (+ la del dominio propio el 20/8)
# OJO: los previews efímeros de ramas feature/* tienen URL cambiante, así que Google
# NO funciona ahí; en esos previews hay que loguearse con usuario y contraseña.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Fechas oficiales del evento para el escaneo de QR (Formato YYYY-MM-DD)
EVENT_DAY_1="2026-09-18"
EVENT_DAY_2="2026-09-19"
EVENT_DAY_3="2026-09-20"
