generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Congregacion {
  id            String        @id @default(cuid())
  nombre        String
  inscripciones Inscripcion[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Inscripcion {
  id             String        @id @default(cuid())
  nombre         String
  email          String
  edad           Int
  congregacionId String?
  congregacion   Congregacion? @relation(fields: [congregacionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([congregacionId])
}
