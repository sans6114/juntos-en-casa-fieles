generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLABORADOR
}

enum EstadoCongregacion {
  PENDIENTE
  APROBADA
}

model User {
  id                  String               @id @default(cuid())
  nombre              String
  email               String               @unique
  password            String
  rol                 Role                 @default(COLABORADOR)
  activo              Boolean              @default(true)
  passwordChangedAt   DateTime             @default(now())
  contactos           Contacto[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Congregacion {
  id                String             @id @default(cuid())
  nombre            String
  /// Clave persistida de normalizacion (NFD, sin diacriticos, minuscula, sin
  /// espacios duplicados). Cambiar el algoritmo que la genera exige una
  /// migracion de backfill: ver `src/lib/congregacion/normalizar.ts`.
  nombreNormalizado String             @unique
  estado            EstadoCongregacion @default(PENDIENTE)
  inscripciones     Inscripcion[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Inscripcion {
  id              String        @id @default(cuid())
  nombre          String
  /// Opcional SOLO para el alta de puerta: quien carga a alguien que esta
  /// entrando no tiene por que pedirle un mail que en ese flujo no se usa.
  /// El formulario publico lo sigue exigiendo desde `CrearInscripcionSchema`,
  /// porque ahi es el unico canal por el que llega el QR.
  /// El unique sigue valiendo: Postgres trata cada NULL como distinto.
  email           String?       @unique
  telefono        String?
  edad            Int
  congregacionId  String?
  congregacion    Congregacion? @relation(fields: [congregacionId], references: [id])
  /// Se marca `true` unicamente cuando el visitante declara que no tiene
  /// congregacion al inscribirse (checkbox "Soy nuevo", ver
  /// `crear-inscripcion.ts`). Rechazar una congregacion NO lo escribe: eso
  /// invalida un nombre cargado, no niega que la persona tenga iglesia.
  /// Invariante: `sinCongregacion = true` implica `congregacionId = null`.
  sinCongregacion Boolean       @default(false)
  contacto        Contacto?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Secreto de la URL publica `/mi-qr/<token>`. NO es el contenido del QR: el
  /// QR sigue codificando `id`, porque las inscripciones existentes ya tienen
  /// ese QR en su mail y cambiar el payload romperia la puerta.
  ///
  /// Lo genera POSTGRES y no la aplicacion. `vercel-build` corre
  /// `prisma migrate deploy && next build`: entre los dos hay minutos con
  /// esquema nuevo y codigo viejo sirviendo trafico, y ese codigo viejo hace
  /// INSERT sin mencionar esta columna. Sin default de base, cada inscripcion
  /// de esa ventana violaria el NOT NULL y se perderia.
  ///
  /// TEXT y no `@db.Uuid` a proposito: con columna uuid nativa, un token con
  /// typo en la URL hace que Prisma tire por sintaxis invalida en vez de
  /// devolver null, y `/mi-qr/<typo>` seria un 500 en vez de un 404.
  qrToken         String        @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-', '')"))
  /// Estado del envio del mail con el QR. Antes no existia: `sendQrEmail` se
  /// tragaba todo error, asi que no habia forma de responder "a quien no le
  /// llego" sin salir de la aplicacion y cruzar la base con los logs.
  /// `emailEnviadoAt`: ultimo envio exitoso.
  emailEnviadoAt  DateTime?
  /// Ultimo error de envio. Vuelve a `null` cuando un envio sale bien.
  emailError      String?
  /// Total de intentos, contando el alta publica y cada reenvio manual.
  emailIntentos   Int           @default(0)
  /// Viernes y sabado. La resolucion de que dia es hoy vive en
  /// `src/lib/asistencia/dia-evento.ts`, fuente unica para el escaner de QR y
  /// para el check manual de la puerta.
  asistenciaDia1  DateTime?
  asistenciaDia2  DateTime?
  /// FUERA DE ALCANCE: el domingo no hay acreditacion. La columna se conserva
  /// —nullable, sin escritores, 0 filas— porque dropearla no aporta nada y
  /// habria que recrearla si el domingo vuelve al cronograma. No agregar
  /// lectores: `DiaEvento` es `1 | 2`.
  asistenciaDia3  DateTime?

  @@index([congregacionId])
}

model Contacto {
  id            String      @id @default(cuid())
  inscripcionId String      @unique
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       User        @relation(fields: [usuarioId], references: [id])
  contactado    Boolean     @default(false)
  observacion   String?
  contactadoAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([usuarioId])
}

enum TipoContenido {
  PREDICA
  VIDEO
  RECURSOS
}

enum CampoThumb {
  CAMPO_PAPEL
  CAMPO_TINTA
  CAMPO_FUEGO
}

model Contenido {
  id             String             @id @default(cuid())
  slug           String             @unique
  titulo         String
  descripcion    String
  tipo           TipoContenido
  edicion        Int
  sesion         String?
  orador         String?
  youtubeId      String?
  duracion       String?
  /// Solo RECURSOS: los archivos descargables. Reemplaza al par
  /// `placasUrl`/`placasCount`, que solo admitia un PDF unico. La cantidad de
  /// placas ya no se persiste: se DERIVA de esta lista en los mappers de
  /// `src/lib/data/contenidos.ts`, para que no se pueda desincronizar.
  archivos       ContenidoArchivo[]
  /// Solo PREDICA: apunta al RECURSOS que tiene sus placas. Un mismo recurso
  /// puede servir a varias predicas, por eso es una FK y no una relacion 1-1.
  /// Un recurso apuntado deja de listarse como card propia en el catalogo
  /// publico (`predicas: { none: {} }` en `obtenerContenidosPublicos`), para no
  /// mostrar la predica y sus placas como dos entradas casi identicas.
  recursoId      String?
  recurso        Contenido?         @relation("PredicaRecurso", fields: [recursoId], references: [id], onDelete: SetNull)
  predicas       Contenido[]        @relation("PredicaRecurso")
  campo          CampoThumb
  imagenSrc      String?
  imagenCover    Boolean            @default(false)
  imagenAtenuada Boolean            @default(false)
  publicado      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([recursoId])
}

/// Un archivo descargable de un contenido RECURSOS: el PDF de placas, o cada
/// imagen suelta (fondos de pantalla, placas individuales). Tabla propia y no
/// un `String[]` en `Contenido` porque hace falta saber el tipo de cada
/// archivo sin parsear su URL, ordenarlos, y poder borrar uno solo.
model ContenidoArchivo {
  id          String    @id @default(cuid())
  contenidoId String
  contenido   Contenido @relation(fields: [contenidoId], references: [id], onDelete: Cascade)
  url         String
  /// `application/pdf` | `image/jpeg` | `image/png`. Decide como se ofrece la
  /// descarga y cuanto aporta al conteo derivado: un PDF suma sus `paginas`,
  /// una imagen suma 1.
  mime        String
  orden       Int       @default(0)
  /// Solo PDF: se deriva con pdf-lib en el browser antes de subir el archivo.
  paginas     Int?
  createdAt   DateTime  @default(now())

  @@index([contenidoId])
}

/// Categoria de producto. Es una TABLA y no un enum a proposito: el admin
/// necesita poder agregar una categoria nueva desde el panel, sin deploy.
/// Se crean unicamente desde el dialogo del form de producto — no hay una
/// seccion de categorias en el admin.
model CategoriaProducto {
  id        String     @id @default(cuid())
  /// Se DERIVA de `nombre` en `crearCategoriaProducto`, no la tipea nadie.
  /// Todavia no la consume ninguna ruta publica: existe para que una futura
  /// `/productos/categoria/{slug}` no necesite migracion, y porque `@unique`
  /// sobre el nombre normalizado es lo que evita categorias duplicadas
  /// —mismo rol que `Congregacion.nombreNormalizado`.
  slug      String     @unique
  nombre    String
  productos Producto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Producto {
  id             String            @id @default(cuid())
  slug           String            @unique
  titulo         String
  descripcion    String
  /// Requerida: todo producto pertenece a una categoria. El borrado queda en
  /// `Restrict` (default de Prisma para una relacion requerida): borrar una
  /// categoria con productos adentro no puede llevarselos puestos.
  categoriaId    String
  categoria      CategoriaProducto @relation(fields: [categoriaId], references: [id])
  /// Rotulo del overlay sobre el marco. Distinto de la categoria: vale
  /// "Remera"/"Stickers" (el objeto), no "Indumentaria" (la categoria).
  badge          String
  /// OBLIGATORIA. Un producto sin foto no existe: ya no hay pieza dibujada de
  /// fallback. Siempre es una URL de Vercel Blob subida desde el panel.
  /// Es la foto principal: la que va en la card del catalogo y en la vista previa.
  imagenSrc      String
  /// OPCIONAL. Segunda foto, el dorso de la prenda o del objeto. Nullable a
  /// proposito: los productos que ya existen no tienen dorso y no pueden
  /// romperse por eso. Cuando esta, tambien es una URL de Vercel Blob.
  imagenDorsoSrc String?
  /// Arranca en false — un producto nuevo nace borrador. Diverge a proposito
  /// de `Contenido.publicado`, que default a true.
  publicado      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([categoriaId])
}
